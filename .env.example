# METRON_VPN environment template
# Copy to ".env" and fill with your real values.
#
# IMPORTANT:
# - Never commit your real ".env" to GitHub.
# - Keep panel credentials and bot tokens private.


# Telegram bot token from @BotFather
# Example format: 123456789:AAAbbbCCCdddEEEfffGGGhhhIIIjjjKKK
BOT_TOKEN=


# Telegram numeric user id for the admin account (integer)
ADMIN_ID=


# 3x-ui panel base URL (no trailing slash)
# Example: https://your-panel-host:43256/metronVPN
PANEL_URL=


# 3x-ui panel credentials
PANEL_USER=
PANEL_PASS=


# Public server IP/host used inside generated VLESS links (no protocol, no port)
# Example: 203.0.113.10
SERVER_IP=


# 3x-ui inbound id (integer). Default in code: 1
INBOUND_ID=1


# Telegram Payments provider token (RUB is used in the code)
PAY_TOKEN=


# --- VLESS / REALITY settings (from your inbound config) ---


# Port exposed for VLESS (string or number)
VLESS_PORT=443


# Transport: tcp | xhttp (must match inbound network in 3x-ui)
VLESS_TYPE=xhttp


# Security mode: reality / tls / none (must match inbound)
VLESS_SECURITY=reality


# SNI / serverName (must match inbound Reality serverNames)
VLESS_SNI=www.microsoft.com


# Fingerprint (uTLS): chrome / firefox / safari / random (must match inbound)
VLESS_FP=chrome


# REALITY public key (pbk) — Public Key из inbound, не Private
VLESS_PBK=


# REALITY short id (sid) — один из Short IDs в панели (hex, часто 8 символов)
VLESS_SID=


# REALITY spiderX (spx) — обычно /
VLESS_SPX=/


# --- только для VLESS_TYPE=xhttp (скопировать из «ссылки» тестового клиента в 3x-ui) ---
# HTTP path инбаунда
VLESS_XHTTP_PATH=/
# Host header (часто пусто или = SNI; если в ссылке панели есть host= — укажите здесь)
VLESS_XHTTP_HOST=
# Режим: auto | stream-one | stream-up | packet-up (как в панели)
VLESS_XHTTP_MODE=auto

# Имя профиля после # в ссылке. Для v2RayTun оставьте false (ломает spx).
VLESS_USE_FRAGMENT=false


# Monthly cost per device in rubles
DEVICE_MONTHLY_COST=100.00


# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/YOUR_DATABASE_NAME


# Number of days for trial accounts (integer)
TRIAL_DAYS=1


# Optional: Telegram bot username (without @), used for display purposes
BOT_NAME=

# HTTPS Mini App URL (must match @BotFather Menu Button)
# Dedicated subdomain: https://pnv.example.com/pages/profile.html
# Path fallback:       https://edge.example.com/pnv/pages/profile.html
WEBAPP_URL=
