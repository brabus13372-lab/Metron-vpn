# METRON_VPN environment template
# Copy to ".env" and fill with your real values.
#
# IMPORTANT:
# - Never commit your real ".env" to GitHub.
# - Keep panel credentials and bot tokens private.


# Telegram bot token from @BotFather
# Example format: 123456789:AAAbbbCCCdddEEEfffGGGhhhIIIjjjKKK
BOT_TOKEN=


# Telegram numeric user id for the admin account (integer)
ADMIN_ID=


# 3x-ui panel base URL (no trailing slash)
# Example: https://your-panel-host:43256/metronVPN
PANEL_URL=


# 3x-ui panel credentials
PANEL_USER=
PANEL_PASS=


# Public server IP/host used inside generated VLESS links (no protocol, no port)
# Example: 203.0.113.10
SERVER_IP=


# 3x-ui inbound id (integer). Default in code: 1
INBOUND_ID=1


# Telegram Payments provider token (RUB is used in the code)
PAY_TOKEN=


# --- VLESS / REALITY settings (from your inbound config) ---


# Port exposed for VLESS (string or number)
VLESS_PORT=443


# Transport type: tcp / ws / grpc / etc. (must match inbound)
VLESS_TYPE=tcp


# Security mode: reality / tls / none (must match inbound)
VLESS_SECURITY=reality


# SNI / serverName (must match inbound)
VLESS_SNI=google.com


# Fingerprint (uTLS): chrome / firefox / safari / random (must match inbound)
VLESS_FP=chrome


# REALITY public key (pbk) from inbound settings
VLESS_PBK=


# Optional: REALITY short id (sid). Leave empty if not required.
VLESS_SID=


# Monthly cost per device in rubles
DEVICE_MONTHLY_COST=100.00


# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/YOUR_DATABASE_NAME


# Number of days for trial accounts (integer)
TRIAL_DAYS=1


# Optional: Telegram bot username (without @), used for display purposes
BOT_NAME=
